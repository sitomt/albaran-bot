# Copiar como .env y completar. Nunca versionar .env.
MISTRAL_API_KEY=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Obligatorio en producción. IDs numéricos de Telegram, separados por comas.
TELEGRAM_ALLOWED_USERS=123456789,987654321

# NIF/CIF del restaurante. Evita confundir al cliente con el proveedor.
CUSTOMER_NIFS=B12345678

# Solo para scripts de backup; no es necesaria dentro del contenedor del bot.
# Usar la URL directa de Postgres y mantener sslmode=require.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
RUNTIME_DIR=runtime

ENVIRONMENT=production
STORAGE_BUCKET=albaranes
MAX_DOCUMENT_BYTES=15728640
MAX_PENDING_PER_USER=20
MAX_PENDING_GLOBAL=100
AUTO_CONFIRM_CLEAN=false
OCR_MODEL=mistral-ocr-4-0
EXTRACTION_MODEL=mistral-small-2603
MONTHLY_AI_BUDGET_USD=25
# 0 desactiva la alerta de presupuesto total del proyecto.
MONTHLY_TOTAL_BUDGET_USD=0
OCR_USD_PER_1000_PAGES=4
LLM_INPUT_USD_PER_MILLION_TOKENS=0.15
LLM_OUTPUT_USD_PER_MILLION_TOKENS=0.60

# Costes fijos contratados. Se muestran separados del consumo medido de IA.
HOSTING_MONTHLY_COST_USD=0
SUPABASE_MONTHLY_COST_USD=0
OTHER_MONTHLY_COST_USD=0
